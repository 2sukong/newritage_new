<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.newritage.app"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.newritage.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.newritage.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.NewRitage" >

        <!-- 스플래시 / 진입점 -->
        <activity
            android:name="com.newritage.app.ui.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.NewRitage.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 온보딩 -->
        <activity
            android:name="com.newritage.app.ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <!-- 시작 페이지 (로그인 전) -->
        <activity
            android:name="com.newritage.app.ui.auth.StartActivity"
            android:exported="false" />

        <!-- 로그인 -->
        <activity
            android:name="com.newritage.app.ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 회원가입 -->
        <activity
            android:name="com.newritage.app.ui.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 기준 압력 측정 (최초 1회) -->
        <activity
            android:name="com.newritage.app.ui.baseline.BaselineMeasurementActivity"
            android:exported="false" />

        <!-- 메인 (하단 내비) -->
        <activity
            android:name="com.newritage.app.ui.main.MainActivity"
            android:exported="false" />

        <!-- 명상 측정 세션 -->
        <activity
            android:name="com.newritage.app.ui.measurement.MeasurementActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 세션 완료 (기록 + 실 제공) -->
        <activity
            android:name="com.newritage.app.ui.measurement.SessionCompleteActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.newritage.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>