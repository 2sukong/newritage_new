<?xml version="1.0" encoding="utf-8"?>
<!-- 원본 점 이미지가 탭 배경으로 쓰이면 탭 너비(간격 확보용으로 넓힌)에 맞춰 가로로 늘어나
     찌그러진 타원이 되므로, gravity="center"로 원본 크기 그대로 중앙에만 그리게 한다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <bitmap android:src="@drawable/tab_indicator_selected" android:gravity="center" />
    </item>
    <item android:state_selected="false">
        <bitmap android:src="@drawable/tab_indicator_unselected" android:gravity="center" />
    </item>
</selector>
