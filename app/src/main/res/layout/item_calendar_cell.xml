<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_margin="4dp">

    <!-- GONE 대신 INVISIBLE: NEW 배지 유무와 상관없이 모든 칸이 같은 세로 구조를 가져야
         칸(threadSquareFrame)이 줄마다 같은 높이에 정렬된다. -->
    <TextView
        android:id="@+id/tvNewBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/badge_new"
        android:textColor="@color/accent_new"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/threadSquareFrame"
        android:layout_width="64dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_rounded_gray_border"
        android:padding="8dp">
        <View
            android:id="@+id/threadSwatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp" />

</LinearLayout>
