<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_margin="4dp">

    <!-- GONE 대신 INVISIBLE: NEW 배지 유무와 상관없이 모든 칸이 같은 세로 구조를 가져야
         칸(threadSquareFrame)이 줄마다 같은 높이에 정렬된다. -->
    <TextView
        android:id="@+id/tvNewBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/badge_new"
        android:textColor="@color/accent_new"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"
        android:visibility="invisible" />

    <!-- NEW 배지 유무와 상관없이 바깥 프레임 자리는 항상 같은 크기(74x86)로 예약해 둔다.
         NEW가 아닐 때는 이 프레임의 배경을 비워 둬서, 상태가 바뀌어도 칸/레이아웃이
         아래로 밀리지 않게 한다. -->
    <FrameLayout
        android:id="@+id/threadNewFrame"
        android:layout_width="70dp"
        android:layout_height="82dp"
        android:padding="3dp">

        <FrameLayout
            android:id="@+id/threadSquareFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp">
            <ImageView
                android:id="@+id/threadSwatch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:visibility="invisible" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp" />

</LinearLayout>
