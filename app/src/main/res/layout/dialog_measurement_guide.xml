<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/guide_title"
        android:textSize="18sp"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="1" android:gravity="center"
            android:textColor="@color/white" android:textSize="12sp"
            android:background="@drawable/bg_circle_green" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  기기를 손에 쥐고 올바른 자세로 앉아주세요."
            android:textSize="14sp" android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="2" android:gravity="center"
            android:textColor="@color/white" android:textSize="12sp"
            android:background="@drawable/bg_circle_green" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  눈을 감고, 어깨에 힘을 빼주세요."
            android:textSize="14sp" android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="3" android:gravity="center"
            android:textColor="@color/white" android:textSize="12sp"
            android:background="@drawable/bg_circle_green" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  가천히 눈을 감고 자연스럽게 집중합니다."
            android:textSize="14sp" android:textColor="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        <TextView android:layout_width="20dp" android:layout_height="20dp"
            android:text="4" android:gravity="center"
            android:textColor="@color/white" android:textSize="12sp"
            android:background="@drawable/bg_circle_green" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  측정은 원하는 시간만큼 진행할 수 있습니다."
            android:textSize="14sp" android:textColor="@color/text_secondary" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStartGuide"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/btn_start_measure"
        android:background="@drawable/btn_primary_bg"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:stateListAnimator="@null" />

</LinearLayout>
