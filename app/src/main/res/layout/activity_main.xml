<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 홈 화면 (압력 측정 대기) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/devDateBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 상단 타이틀 바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbarHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/measurement_title"
                android:fontFamily="@font/spoqahansansneo_regular"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:id="@+id/btnHelpHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/measurement_help"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="10sp"
                    android:textColor="#7DAA84" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/icon_help" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 스크롤 본문 -->
        <ScrollView
            android:id="@+id/scrollHome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/toolbarHome"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <!-- 상단 안내 문구 -->
                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginEnd="24dp"
                    android:alpha="0.66"
                    android:fontFamily="@font/spoqahansansneo_regular"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/measurement_instruction"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 원형 게이지 (측정 화면의 원과 동일한 크기를 공유) -->
                <FrameLayout
                    android:id="@+id/gaugeContainer"
                    android:layout_width="227dp"
                    android:layout_height="227dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_gauge_shadow_base"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:outlineProvider="background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvInstruction">

                    <com.newritage.app.ui.util.WaveView
                        android:id="@+id/waveView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- 탭하면 바로 측정 화면으로 이동한다 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="24dp"
                        android:fontFamily="@font/spoqahansansneo_regular"
                        android:text="@string/measurement_waiting"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/groupIdle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="6dp"
                            android:contentDescription="@string/btn_start_measure"
                            android:src="@drawable/ic_play_triangle" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 기기 연결 상태 배지 -->
                <LinearLayout
                    android:id="@+id/badgeConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-18dp"
                    android:layout_marginEnd="-50dp"
                    android:background="@drawable/bg_connection_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingLeft="50dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    app:layout_constraintEnd_toEndOf="@id/gaugeContainer"
                    app:layout_constraintTop_toBottomOf="@id/gaugeContainer">

                    <View
                        android:id="@+id/dotConnection"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/connection_disconnected"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 측정 모드 선택 (자율 모드 / 가이드 모드) -->
                <LinearLayout
                    android:id="@+id/rowModeSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/badgeConnection">

                    <TextView
                        android:id="@+id/btnModeAutonomous"
                        android:layout_width="108dp"
                        android:layout_height="33dp"
                        android:background="@drawable/bg_mode_button_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center"
                        android:text="@string/mode_autonomous"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnModeGuide"
                        android:layout_width="108dp"
                        android:layout_height="33dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_mode_button_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="center"
                        android:text="@string/mode_guide"
                        android:textColor="@color/mode_unselected_text"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- 임계치 이상 알림 토글 -->
                <LinearLayout
                    android:id="@+id/rowThresholdAlert"
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowModeSelect">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="right"
                        android:text="@string/threshold_alert_toggle_label"
                        android:textColor="@color/text_add"
                        android:textSize="10sp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchThresholdAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track" />

                </LinearLayout>

                <!-- 측정 안내 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardGuide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_card_surface_bordered"
                    android:paddingStart="16dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="19dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rowThresholdAlert">

                    <TextView
                        android:id="@+id/tvGuideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/spoqahansansneo_bold"
                        android:text="@string/guide_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/rowGuide1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvGuideTitle">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_one" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:text="@string/guide_step_1"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGuide2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rowGuide1">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_two" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:text="@string/guide_step_2"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGuide3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rowGuide2">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_three" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:text="@string/guide_step_3"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGuide4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/rowGuide3">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_four" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:text="@string/guide_step_4"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 프래그먼트 컨테이너 (하단 내비 이동 시) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/devDateBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 시연용 개발자 날짜바 (임시 날짜 + 넘기기). 배포 시 visibility=gone 처리 -->
    <LinearLayout
        android:id="@+id/devDateBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#11000000"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnDevPrevDay"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text="◀"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvDevDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="임시 날짜"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDevNextDay"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text="▶"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- 하단 내비게이션 카드 위의 그림자. 두 개의 View로 구성됨:
         1) bottomNavShadowNotch: bottomNav의 "위쪽" 끝(top)에 맞춰 배치하되 높이(24dp)만큼
            카드 내부로 겹쳐 들어간다. bottomNav보다 먼저 그려지므로(=z-order상 아래), 카드가
            불투명하게 덮는 부분(위쪽 둥근 모서리 두 곳을 제외한 나머지)은 가려져서 안 보이고,
            카드의 둥근 모서리 곡선 바깥쪽에 남는 투명한 notch(빈 틈)에서만 이 View의 색이
            비쳐 보인다 — 그 부분에도 그림자가 자연스럽게 이어지도록 채워주는 역할.
         2) bottomNavShadowReach: 카드 바로 위(bottomNav의 top보다 위)에 이어 붙여서, 카드에서
            멀어질수록 옅어지는 그라데이션으로 그림자가 "위로 뻗어" 보이게 한다. 이전엔 이
            영역이 36dp라 그림자 밴드가 화면 상당 부분을 덮는 것처럼 보였어서(사용자 피드백),
            20dp로 줄여 카드 바로 위에만 좁고 자연스럽게 걸치도록 했다.
         두 View 모두 겹치는 경계(bottomNav의 top 지점)에서 같은 색상(#20000000)으로 시작/종료
         하도록 맞춰서 이어붙인 자리에 눈에 띄는 경계선이 남지 않게 했다. -->
    <View
        android:id="@+id/bottomNavShadowNotch"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_bottom_nav_shadow_notch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottomNav" />

    <!-- 하단 내비게이션 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:paddingStart="29dp"
        android:paddingEnd="25dp"
        android:background="@drawable/bg_bottom_nav"
        android:outlineProvider="background"
        android:elevation="6dp"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/menu"
        app:itemTextColor="@color/menu"
        app:itemIconSize="25dp"
        app:itemPaddingTop="25dp"
        app:itemPaddingBottom="23dp"
        app:labelVisibilityMode="labeled"
        app:itemRippleColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemTextAppearanceInactive="@style/BottomNavTextInactive"
        app:itemTextAppearanceActive="@style/BottomNavTextActive"
        app:itemTextAppearanceActiveBoldEnabled="false" />

    <View
        android:id="@+id/bottomNavShadowReach"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:background="@drawable/gradient_bottom_nav_shadow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

</androidx.constraintlayout.widget.ConstraintLayout>
