<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 홈 화면 (압력 측정 대기) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/devDateBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 상단 타이틀 바 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbarHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/measurement_title"
                android:fontFamily="@font/spoqaHanSansNeo_Regular"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:id="@+id/btnHelpHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/measurement_help"
                    android:fontFamily="@font/inter_semibold"
                    android:textSize="10sp"
                    android:textColor="#7DAA84" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/icon_help" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 스크롤 본문 -->
        <ScrollView
            android:id="@+id/scrollHome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/toolbarHome"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">

                <!-- 상단 안내 문구 -->
                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/measurement_instruction"
                    android:fontFamily="@font/spoqaHanSansNeo_Regular"
                    android:textSize="16sp"
                    android:textColor="@color/text_add"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginTop="28dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 원형 게이지 (측정 화면의 원과 동일한 크기를 공유) -->
                <FrameLayout
                    android:id="@+id/gaugeContainer"
                    android:layout_width="227dp"
                    android:layout_height="227dp"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:background="@drawable/bg_gauge_shadow_base"
                    android:elevation="6dp"
                    android:outlineProvider="background"
                    app:layout_constraintTop_toBottomOf="@id/tvInstruction"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.newritage.app.ui.util.WaveView
                        android:id="@+id/waveView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- 탭하면 바로 측정 화면으로 이동한다 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="24dp"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/measurement_waiting"
                        android:fontFamily="@font/spoqaHanSansNeo_Regular"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/groupIdle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="6dp"
                            android:src="@drawable/ic_play_triangle"
                            android:contentDescription="@string/btn_start_measure" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 기기 연결 상태 배지 -->
                <LinearLayout
                    android:id="@+id/badgeConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_connection_badge"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingLeft="50dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="-18dp"
                    android:layout_marginEnd="-50dp"
                    app:layout_constraintTop_toBottomOf="@id/gaugeContainer"
                    app:layout_constraintEnd_toEndOf="@id/gaugeContainer">

                    <View
                        android:id="@+id/dotConnection"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot" />

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/connection_disconnected"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="10sp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- 측정 모드 선택 (자율 모드 / 가이드 모드) -->
                <LinearLayout
                    android:id="@+id/rowModeSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/badgeConnection"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/btnModeAutonomous"
                        android:layout_width="108dp"
                        android:layout_height="33dp"
                        android:gravity="center"
                        android:text="@string/mode_autonomous"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_mode_button_selected"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnModeGuide"
                        android:layout_width="108dp"
                        android:layout_height="33dp"
                        android:layout_marginStart="14dp"
                        android:gravity="center"
                        android:text="@string/mode_guide"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/mode_unselected_text"
                        android:background="@drawable/bg_mode_button_unselected"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- 임계치 이상 알림 토글 -->
                <LinearLayout
                    android:id="@+id/rowThresholdAlert"
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/rowModeSelect"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/threshold_alert_toggle_label"
                        android:gravity="right"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="10sp"
                        android:textColor="@color/text_add" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchThresholdAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track" />

                </LinearLayout>

                <!-- 측정 안내 -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardGuide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface_bordered"
                    android:paddingTop="18dp"
                    android:paddingBottom="19dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@id/rowThresholdAlert"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tvGuideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guide_title"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/spoqaHanSansNeo_Bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:id="@+id/rowGuide1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvGuideTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_one" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:text="@string/guide_step_1"
                            android:fontFamily="@font/spoqaHanSansNeo_Regular"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGuide2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/rowGuide1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_two" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:text="@string/guide_step_2"
                            android:fontFamily="@font/spoqaHanSansNeo_Regular"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGuide3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/rowGuide2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_three" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:text="@string/guide_step_3"
                            android:fontFamily="@font/spoqaHanSansNeo_Regular"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowGuide4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/rowGuide3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <FrameLayout
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:background="@drawable/bg_icon_circle">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/guide_four" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:text="@string/guide_step_4"
                            android:fontFamily="@font/spoqaHanSansNeo_Regular"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 프래그먼트 컨테이너 (하단 내비 이동 시) -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/devDateBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 시연용 개발자 날짜바 (임시 날짜 + 넘기기). 배포 시 visibility=gone 처리 -->
    <LinearLayout
        android:id="@+id/devDateBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#11000000"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnDevPrevDay"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text="◀"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvDevDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="임시 날짜"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDevNextDay"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text="▶"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

    <!-- 하단 내비게이션 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/menu"
        app:itemTextColor="@color/menu"
        app:itemIconSize="25dp"
        app:labelVisibilityMode="labeled"
        app:itemRippleColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemTextAppearanceInactive="@style/BottomNavTextInactive"
        app:itemTextAppearanceActive="@style/BottomNavTextActive"/>/>

</androidx.constraintlayout.widget.ConstraintLayout>
