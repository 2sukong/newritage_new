<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- 배경 1: 그라데이션 -->
    <View
        android:id="@+id/bgGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings_gradient" />

    <!-- 배경 2: 반투명 사진 -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/background"
        android:scaleType="centerCrop"
        android:alpha="0.45" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <include layout="@layout/view_settings_group_header"
                android:id="@+id/groupAccount" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_75"
                app:cardCornerRadius="8dp">
                <include layout="@layout/view_settings_row" android:id="@+id/rowAccountManage" />
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_settings_group_header"
                android:id="@+id/groupSecurity" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_75"
                app:cardCornerRadius="8dp">
                <include layout="@layout/view_settings_row" android:id="@+id/rowPassword" />
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_settings_group_header"
                android:id="@+id/groupApp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_75"
                app:cardCornerRadius="8dp">
                <include layout="@layout/view_settings_row" android:id="@+id/rowNotificationReset" />
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_settings_group_header"
                android:id="@+id/groupPressure" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_75"
                app:cardCornerRadius="8dp">
                <include layout="@layout/view_settings_row" android:id="@+id/rowMeasureStandard" />
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_settings_group_header"
                android:id="@+id/groupVibration" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_75"
                app:cardCornerRadius="8dp">
                <include layout="@layout/view_settings_row" android:id="@+id/rowVibrationManage" />
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_settings_group_header"
                android:id="@+id/groupHelp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_75"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/view_settings_row" android:id="@+id/rowNotice" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider" />
                    <include layout="@layout/view_settings_row" android:id="@+id/rowCs" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/divider" />
                    <include layout="@layout/view_settings_row" android:id="@+id/rowGuide" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
