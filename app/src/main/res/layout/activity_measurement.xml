<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 상단 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/measurement_title"
            android:fontFamily="@font/spoqahansansneo_regular"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/btnHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/measurement_help"
                android:fontFamily="@font/inter_semibold"
                android:textSize="10sp"
                android:textColor="#81A68D" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/icon_help" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 스크롤 본문 -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/btnStop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- 현재 압력 상태 -->
            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pressure_status_title"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvStatusDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/pressure_status_calm_desc"
                android:fontFamily="@font/spoqahansansneo_regular"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:alpha="0.66"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 원형 게이지 -->
            <FrameLayout
                android:id="@+id/gaugeContainer"
                android:layout_width="227dp"
                android:layout_height="227dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_gauge_shadow_base"
                android:elevation="6dp"
                android:outlineProvider="background"
                app:layout_constraintTop_toBottomOf="@id/tvStatusDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.newritage.app.ui.util.WaveView
                    android:id="@+id/waveView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvTensionStatus"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="측정 중…"
                    android:textColor="@color/text_add"
                    android:fontFamily="@font/spoqahansansneo_regular"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvCurrentPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="45sp"
                            android:textColor="@color/text_other"
                            android:fontFamily="@font/spoqahansansneo_bold" />

                        <TextView
                            android:id="@+id/tvPressureUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginBottom="2dp"
                            android:text="kPa"
                            android:textSize="13sp"
                            android:textColor="@color/text_other"
                            android:fontFamily="@font/spoqahansansneo_medium" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- 일시정지 + 명상 시간 -->
            <LinearLayout
                android:id="@+id/cardTimer"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:minHeight="51dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_timer_card"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/gaugeContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btnPause"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pause_circle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="@font/spoqahansansneo_medium"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 그래프 레이블 -->
            <TextView
                android:id="@+id/tvChartLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/realtime_chart_label"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardTimer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 실시간 그래프 -->
            <FrameLayout
                android:id="@+id/cardChart"
                android:layout_width="341dp"
                android:layout_height="278dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvChartLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp" />

                <!-- 실시간 압력 그래프의 마지막 값을 가리키는 바늘. 좌상단(0,0)이 바늘의
                     뾰족한 끝이 되도록 needle.xml이 그려져 있어, MeasurementActivity에서
                     pivotX/pivotY=0으로 회전하고 x/y만 매 tick 갱신해 그래프 곡선 위에 끝이 닿도록 한다. -->
                <ImageView
                    android:id="@+id/ivNeedle"
                    android:layout_width="9.54dp"
                    android:layout_height="25.54dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/needle"
                    android:scaleType="fitXY"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <!-- 높음/적정/낮음 기준 텍스트. 점선 없이 텍스트만 표시하며, 곡선·바늘보다
                     오른쪽인 카드 우측 끝에 고정한다(세로 위치는 MeasurementActivity의
                     positionLevelLabels()에서 baseline 기준값에 맞춰 1회 계산). -->
                <TextView
                    android:id="@+id/tvLevelHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="4dp"
                    android:text="@string/chart_level_high"
                    android:fontFamily="@font/spoqahansansneo_regular"
                    android:textColor="@color/text_primary"
                    android:alpha="0.66"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvLevelModerate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="4dp"
                    android:text="@string/chart_level_moderate"
                    android:fontFamily="@font/spoqahansansneo_regular"
                    android:textColor="@color/text_primary"
                    android:alpha="0.66"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvLevelLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="4dp"
                    android:text="@string/chart_level_low"
                    android:fontFamily="@font/spoqahansansneo_regular"
                    android:textColor="@color/text_primary"
                    android:alpha="0.66"
                    android:textSize="10sp" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- 완료 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStop"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:text="@string/btn_stop"
        android:background="@drawable/bg_btn_soft_light"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:fontFamily="@font/spoqahansansneo_medium"
        android:stateListAnimator="@null"
        android:elevation="8dp"
        android:outlineProvider="background"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
