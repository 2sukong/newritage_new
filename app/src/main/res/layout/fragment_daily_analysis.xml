<?xml version="1.0" encoding="utf-8"?>
<!-- 전체 내용을 스크롤 가능하게 만드는 최상위 ScrollView -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- 1. 상단 타이틀 바 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:scaleType="center"
                android:src="@drawable/back"
                android:contentDescription="뒤로가기" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="피드백"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </RelativeLayout>

        <!-- 2. 일간 날짜 내비게이션 (2026.05.20 (월) 형태) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/btnPrevDay"
                android:src="@drawable/a"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026.05.20 (월)"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/btnNextDay"
                android:src="@drawable/b"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="4dp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <!-- 측정 기록이 하나도 없을 때 보여줄 안내 (기본 숨김) -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingHorizontal="24dp"
            android:paddingTop="120dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analysis_empty_title"
                android:textSize="16sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/emptyStartMeasure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="@string/analysis_empty_action"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <!-- 측정 기록이 있을 때 보여줄 실제 분석 섹션들 -->
        <LinearLayout
            android:id="@+id/contentSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- 3. 오늘의 한눈에 보기 섹션 (모든 칸 크기 및 비율 완벽 통일) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘의 한눈에 보기"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/acard"
                android:orientation="horizontal"
                android:paddingVertical="20dp"
                android:paddingHorizontal="4dp"
                android:baselineAligned="false">

                <!-- 1. 평균 압력 (비율 1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="평균 압력" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                        <TextView android:id="@+id/tvAvgPressure1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="32.4" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="kPa" android:textSize="8sp" android:textColor="@color/text_hint" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="32dp" android:background="#D1DCD2" android:layout_gravity="center_vertical"/>

                <!-- 3. 최고 압력 (비율 1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="최고 압력" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                        <TextView android:id="@+id/tvAvgPressure3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="48.2" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="kPa" android:textSize="8sp" android:textColor="@color/text_hint" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="32dp" android:background="#D1DCD2" android:layout_gravity="center_vertical"/>

                <!-- 4. 명상 시간 (비율 1) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="명상 시간" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" >
                        <TextView android:id="@+id/tvMedTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="20:15" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="분" android:textSize="8sp" android:textColor="@color/text_hint" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. 압력 변화 요약 (실시간 데이터 밀도 그래프) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="압력 변화 요약"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTrendComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- 5. 센서별 상세 분석 (★ 새로운 추가 스크롤 영역) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="센서별 상세 분석"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- 센서 A 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/acard"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <!-- 초록 동그라미 아이콘은 텍스트 왼쪽에 유동적으로 넣거나 drawableLeft 사용 가능 -->
                    <TextView android:id="@+id/tvSensorAName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="● 센서 A" android:textColor="#8B9E7B" android:textStyle="bold" android:textSize="14sp"/>

                </RelativeLayout>
                <TextView android:id="@+id/tvSensorADetail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="최고 45.0 / 평균 30.1 kPa" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- 센서 B 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/acard"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/tvSensorBName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="● 센서 B" android:textColor="#6C8FB6" android:textStyle="bold" android:textSize="14sp"/>

                </RelativeLayout>
                <TextView android:id="@+id/tvSensorBDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="최고 42.1 / 평균 31.5 kPa" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- 센서 C 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/acard"
                android:orientation="vertical"
                android:padding="16dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/tvSensorCName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="● 센서 C" android:textColor="#D1B06B" android:textStyle="bold" android:textSize="14sp"/>

                </RelativeLayout>
                <TextView android:id="@+id/tvSensorCDetail" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="최고 51.3 / 평균 35.6 kPa" android:textSize="12sp" android:textColor="@color/text_primary" android:layout_marginTop="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 6. 오늘의 코멘트 섹션 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘의 코멘트"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <!-- 코멘트가 들어갈 둥근 빈 카드 -->
            <TextView
                android:id="@+id/tvDailyComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="140dp"
                android:background="@drawable/acard"
                android:padding="16dp"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:gravity="top|start" />
        </LinearLayout>

        </LinearLayout>
        <!-- /contentSections -->

    </LinearLayout>
</ScrollView>