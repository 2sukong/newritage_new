<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 1. 상단 타이틀바 (뒤로가기 + 중앙 타이틀) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/background">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:scaleType="center"
            android:src="@drawable/back"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/analysis_title"
            android:fontFamily="@font/spoqahansansneo_regular"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </RelativeLayout>

    <!-- 2. 하단 콘텐츠 영역 (Figma node 1843:2011 정합화) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/greencard"
        android:orientation="vertical"
        android:paddingTop="96dp">

        <!-- 나의 명상 타이틀 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:text="@string/my_meditation"
            android:fontFamily="@font/spoqahansansneo_medium"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <!-- 설명 문구 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="6dp"
            android:text="@string/analysis_desc"
            android:fontFamily="@font/spoqahansansneo_regular"
            android:textColor="@color/text_add"
            android:textSize="16sp" />

        <!-- 3. 일간 분석 카드 -->
        <LinearLayout
            android:id="@+id/rowDailyAnalysis"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_analysis_card"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/daily_analysis"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="15dp"
                android:contentDescription="이동"
                android:src="@drawable/next" />
        </LinearLayout>

        <!-- 4. 주간 분석 카드 -->
        <LinearLayout
            android:id="@+id/rowWeeklyAnalysis"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_analysis_card"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weekly_analysis"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="15dp"
                android:contentDescription="이동"
                android:src="@drawable/next" />
        </LinearLayout>

        <!-- 5. 월간 분석 카드 -->
        <LinearLayout
            android:id="@+id/rowMonthlyAnalysis"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_analysis_card"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="26dp"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/monthly_analysis"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="15dp"
                android:contentDescription="이동"
                android:src="@drawable/next" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>