<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ─── 1. 기록 리뷰 / 감정 화면 (마스터 레이아웃 디자인 기준, "오늘의 기록"/"오늘의 감정"
         타이틀만 병합본 폰트 위계(18sp bold)를 유지) ─── -->
    <LinearLayout
        android:id="@+id/layoutRecord"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 툴바 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:background="@color/background">

            <ImageButton
                android:id="@+id/btnBackRecord"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_back"
                android:src="@drawable/back" />

            <TextView
                android:id="@+id/tvReviewLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/review_label"
                android:fontFamily="@font/spoqahansansneo_regular"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:letterSpacing="0.12" />

            <View android:layout_width="40dp" android:layout_height="40dp" />

        </LinearLayout>

        <!-- 본문 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <TextView
                android:id="@+id/tvTodayRecordTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/review_today_record"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:textSize="20sp"
                android:textColor="@color/text_primary" />

            <!-- 통계 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="#F2F1F0"
                app:cardBackgroundColor="#FEFDFE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/review_row_med_time"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvRecordMedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--:----:--"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/result"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E3E3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/review_row_avg_tension"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvRecordAvgPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--N"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/result"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E3E3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/review_row_minmax_tension"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvRecordMinMaxPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--N"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/result"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E3E3E3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/review_row_deviation_count"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvRecordDeviationCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--회"
                            android:fontFamily="@font/spoqahansansneo_regular"
                            android:textColor="@color/result"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 오늘의 감정 -->
            <TextView
                android:id="@+id/tvTodayEmotionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginBottom="10dp"
                android:text="@string/review_today_emotion"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:textSize="20sp"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/etEmotion"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_mind"
                android:gravity="top|start"
                android:hint="@string/review_emotion_hint"
                android:fontFamily="@font/spoqahansansneo_medium"
                android:textColorHint="@color/primary_dark"
                android:alpha="0.91"
                android:padding="18dp"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:inputType="textMultiLine" />

        </LinearLayout>

        <!-- 하단 버튼 (건너뛰기 / 기록하기) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:background="@color/background"
            android:elevation="4dp">

            <!-- 그림자(bg_btn_record_shadow)가 버튼과 같은 좌상단에 깔리고, 버튼(64x26)보다
                 3dp 큰 67x29 프레임 크기 덕분에 그림자의 우측/하단 여분만 버튼 바깥으로
                 비쳐 보임(좌측/상단은 버튼 자신이 가림). 버튼 자체의 stateListAnimator를
                 @null로 꺼서 AppCompat 기본 버튼 스타일의 resting elevation(사각 경계 기준
                 자동 그림자, 버튼 위쪽까지 삐져나와 보이던 원인)도 제거함 -->
            <FrameLayout
                android:layout_width="67dp"
                android:layout_height="29dp"
                android:layout_marginEnd="8dp">

                <View
                    android:layout_width="67dp"
                    android:layout_height="29dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_btn_record_shadow" />

                <Button
                    android:id="@+id/btnSkipRecord"
                    android:layout_width="64dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/btn_skip_record"
                    android:fontFamily="@font/spoqahansansneo_medium"
                    android:textColor="@color/text_primary"
                    android:alpha="0.66"
                    android:textSize="10sp"
                    android:background="@drawable/btn_outline_bg"
                    app:backgroundTint="@null" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="67dp"
                android:layout_height="29dp">

                <View
                    android:layout_width="67dp"
                    android:layout_height="29dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_btn_record_shadow" />

                <Button
                    android:id="@+id/btnSaveRecord"
                    android:layout_width="64dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:text="@string/btn_save_record"
                    android:fontFamily="@font/spoqahansansneo_medium"
                    android:textColor="@color/text_primary"
                    android:alpha="0.66"
                    android:textSize="10sp"
                    android:background="@drawable/btn_outline_bg"
                    app:backgroundTint="@null" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ─── 2. 기록 완료(잠깐 보여주는 애니메이션) ─── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSaved"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/savedGaugeContainer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_gauge_shadow_base"
            android:elevation="6dp"
            android:outlineProvider="background"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.newritage.app.ui.util.WaveView
                android:id="@+id/waveViewSaved"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/tvSavedTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saved_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvStreakDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ─── 3. 실 제공 화면 ─── -->
    <ScrollView
        android:id="@+id/layoutThread"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvThreadEyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/thread_eyebrow"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvThreadTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/thread_provide_title"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tvThreadEyebrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvThreadDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_hint"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvThreadTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 실 색상 박스 -->
            <FrameLayout
                android:id="@+id/threadFrameContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="28dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintTop_toBottomOf="@id/tvThreadDate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/threadColorView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="16dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/frame" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvThreadColorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/threadFrameContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 오늘의 일기에서 뽑은 감정 키워드 -->
            <TextView
                android:id="@+id/tvKeywords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvThreadColorName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 일기·감정을 분석한 코멘트 -->
            <TextView
                android:id="@+id/tvEmotionComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tip_card"
                android:padding="24dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvKeywords"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnGoMain" />

            <Button
                android:id="@+id/btnGoMain"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="@string/btn_go_main"
                android:background="@drawable/btn_primary_bg"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:stateListAnimator="@null"
                android:layout_marginTop="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</FrameLayout>
